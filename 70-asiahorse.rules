# AsiaHorse Umbra ARGB hub (QinHeng "USBFAN") - allow user-space HID control
# Numbered below 73-seat-late.rules: the uaccess tag must exist before that file applies the ACL.
# V1: 1a86:fe05 "USBFAN". V2 (sold from 2026-10-09): 1a86:fe04 "ROBOBLOQ ARGB2".
KERNEL=="hidraw*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="fe05", MODE="0660", GROUP="plugdev"
KERNEL=="hidraw*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="fe04", MODE="0660", GROUP="plugdev"
# Same hubs matched on their HID name (0003:1A86:FE0x.*): also covers the umbra_emu.py virtual hub,
# which has no USB parent. uaccess = access for the logged-in desktop user, no group needed.
SUBSYSTEM=="hidraw", KERNELS=="0003:1A86:FE05.*", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNELS=="0003:1A86:FE04.*", TAG+="uaccess"
